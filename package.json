{
  "name": "sundown",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @sundown/web dev",
    "build": "pnpm --filter @sundown/web build",
    "start": "pnpm --filter @sundown/web start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed": "node --import tsx scripts/seed.ts",
    "record": "node --import tsx scripts/record.ts",
    "format": "prettier --write .",
    "smoke": "node --import tsx scripts/smoke.ts",
    "sundown": "node packages/cli/bin/sundown.mjs",
    "live:sandbox": "node --import tsx scripts/live-sandbox.ts",
    "live:sandbox:headed": "node --import tsx scripts/live-sandbox.ts --headed",
    "live:legacy:headed": "node --import tsx scripts/live-sandbox.ts --headed --legacy-only"
  },
  "dependencies": {
    "@bryntum/gantt": "npm:@bryntum/gantt-trial@^7.3.4",
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "2.5.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "@sundown/agents": "workspace:*",
    "@sundown/engine": "workspace:*",
    "ag-studio": "3.1.0",
    "ag-studio-react": "3.1.0",
    "cmdk": "^1.1.1",
    "dotenv": "^17.2.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^3.15.0",
    "three": "^0.181.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@sundown/cli": "workspace:*",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  },
  "type": "module"
}
